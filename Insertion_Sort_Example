
#Insertion Sort Template/Example in Python
A = [5, 2, 4, 6, 1, 3]

print("Original Array: ", A)



#Insertion Sort
"""for j = 2 to A.lenth
	   key = A[j]
       // Insert A[j] into sorted sequence A[1...j-1]
       i = j - 1
       while i > 0 and A[i] > key
       i = i - 1
    A[i + 1] = key

"""
A_len = len(A)
for j in range(1, A_len):
    key = A[j]
    
    # Insert A[j] into sorted sequence A[1...j-1]
    i = j - 1
    
    while i > 0 and A[i] > key:
      A[i + 1] = A[i]
      i = i - 1
    
    A[i + 1] = key

print("Sorted array: ", A)
  	  
